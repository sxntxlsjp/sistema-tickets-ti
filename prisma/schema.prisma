generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(150)
  legalName    String?
  taxId        String?
  logoUrl      String?
  primaryColor String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     TenantUser[]
  tickets         Ticket[]
  ticketTypes     TicketType[]
  ticketSubtypes  TicketSubtype[]
  ticketPriorities TicketPriority[]
  systemSettings  SystemSetting[]

  @@map("tenants")
}

model TenantUser {
  id        Int        @id @default(autoincrement())
  tenantId  Int
  userId    Int
  role      TenantRole @default(USER)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

model SystemSetting {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  key         String
  value       String
  type        SettingType
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

model User {
  id               Int                  @id @default(autoincrement())
  name             String               @db.VarChar(100)
  email            String               @unique @db.VarChar(150)
  passwordHash     String               @map("password_hash")
  role             Role                 @default(USER)
  isSuperAdmin     Boolean              @default(false)
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  department       String?
  phone            String?
  profileImage     String?              @map("profile_image")
  jobTitle         String?              @map("job_title")
  attachments      TicketAttachment[]
  comments         TicketComment[]
  histories        TicketHistory[]
  satisfactions    TicketSatisfaction[]
  assignedTickets  Ticket[]             @relation("AssignedTickets")
  requestedTickets Ticket[]             @relation("RequestedTickets")
  tenantMemberships TenantUser[]

  @@map("users")
}

model TicketType {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  tickets     Ticket[]
  subtypes TicketSubtype[]
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("ticket_types")
}

model TicketSubtype {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  ticketTypeId Int
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@unique([ticketTypeId, name])
  @@index([tenantId])
  @@index([ticketTypeId])
  @@index([isActive])
  @@index([displayOrder])
  @@map("ticket_subtypes")
}

model TicketPriority {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  name               String
  description        String?
  slaDurationMinutes Int
  color              String?
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  tickets Ticket[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@index([displayOrder])
  @@map("ticket_priorities")
}

model Ticket {
  id              Int                  @id @default(autoincrement())
  tenantId        Int
  ticketNumber    String               @unique @map("ticket_number") @db.VarChar(30)
  requestedBy     Int                  @map("requested_by")
  typeId          Int                  @map("type_id")
  subject         String               @db.VarChar(200)
  assignedTo      Int?                 @map("assigned_to")
  description     String
  status          TicketStatus         @default(EN_REVISION)

  // SLA actual existente
  slaDueAt        DateTime?            @map("sla_due_at")
  slaStatus       String               @default("ON_TIME") @map("sla_status") @db.VarChar(30)

  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  closedAt        DateTime?            @map("closed_at")

  countryId       Int?
  ticketSubtypeId Int?
  priorityId      Int?

  slaStartedAt    DateTime?
  slaResolvedAt   DateTime?

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  assignee        User?                @relation("AssignedTickets", fields: [assignedTo], references: [id])
  requester       User                 @relation("RequestedTickets", fields: [requestedBy], references: [id])
  type            TicketType           @relation(fields: [typeId], references: [id])
  country         Country?             @relation(fields: [countryId], references: [id])
  ticketSubtype   TicketSubtype?       @relation(fields: [ticketSubtypeId], references: [id])
  priority TicketPriority? @relation(fields: [priorityId], references: [id])

  attachments     TicketAttachment[]
  comments        TicketComment[]
  histories       TicketHistory[]
  satisfaction    TicketSatisfaction?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedTo])
  @@index([countryId])
  @@index([ticketSubtypeId])
  @@index([priorityId])
  @@index([slaDueAt])
  @@map("tickets")
}

model TicketAttachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  filePath   String   @map("file_path")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  uploadedBy Int?     @map("uploaded_by")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader   User?    @relation(fields: [uploadedBy], references: [id])

  @@map("ticket_attachments")
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int      @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("ticket_comments")
}

model TicketHistory {
  id            Int           @id @default(autoincrement())
  ticketId      Int           @map("ticket_id")
  changedBy     Int           @map("changed_by")
  oldStatus     TicketStatus? @map("old_status")
  newStatus     TicketStatus? @map("new_status")
  oldAssignedTo Int?          @map("old_assigned_to")
  newAssignedTo Int?          @map("new_assigned_to")
  createdAt     DateTime      @default(now()) @map("created_at")
  changer       User          @relation(fields: [changedBy], references: [id])
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_history")
}

model TicketSatisfaction {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @unique @map("ticket_id")
  userId    Int      @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("ticket_satisfaction")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  flagEmoji String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@map("countries")
}

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum TenantRole {
  TENANT_ADMIN
  AGENT
  USER
}

enum TicketStatus {
  EN_REVISION
  PENDIENTE
  FINALIZADO
}


enum SettingType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}
